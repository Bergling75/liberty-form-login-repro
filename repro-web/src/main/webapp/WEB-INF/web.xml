<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>liberty-form-login-repro</display-name>

    <!-- Captures request.getUserPrincipal() immediately after FORM-login authentication
         completes, by wrapping /j_security_check in a Filter. This is the well-known idiom
         for post-login processing (auditing, custom bookkeeping, etc.) that regressed in
         Open Liberty 26.0.0.5+. -->
    <filter>
        <filter-name>PostLoginCaptureFilter</filter-name>
        <filter-class>com.example.repro.PostLoginCaptureFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>PostLoginCaptureFilter</filter-name>
        <url-pattern>/j_security_check</url-pattern>
    </filter-mapping>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected pages</web-resource-name>
            <url-pattern>/welcome.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>reprouser</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>reproRealm</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/loginError.jsp</form-error-page>
        </form-login-config>
    </login-config>

    <security-role>
        <role-name>reprouser</role-name>
    </security-role>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
